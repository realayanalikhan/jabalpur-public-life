---
/**
 * Citation surface ("Use and cite", decision 0027; palette 0025: the warm band is for small citation
 * and press surfaces only). Content serif at caption size on the warm band.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<aside class="citation" aria-label={title}>
  <p class="citation-title type-label">{title}</p>
  <div class="citation-body">
    <slot />
  </div>
</aside>

<style>
  @layer components {
    .citation {
      display: grid;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-5);
      background-color: var(--color-citation-surface);
      color: var(--color-citation-text);
    }
    .citation-title {
      font-weight: var(--weight-semibold);
    }
    .citation-body {
      font-size: var(--size-caption);
      line-height: var(--leading-caption);
    }
  }
</style>
