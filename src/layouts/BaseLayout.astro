---
/**
 * Base document for every page (scaffold plan §8–§9, §12). Handles lang, canonical, hreflang (genuine
 * equivalents only, x-default → /hi/), noindex (notice pages; every page outside production), the
 * preview-only banner, the global styles, the body-font preload, and the site header and footer.
 * Navigation lists only sections that are visible and built (src/lib/navigation.ts).
 */
import '../styles/global.css';
import type { Site } from '../lib/site.ts';
import { hreflangLinks, type RouteDef } from '../lib/routes.ts';
import { withBase } from '../lib/env.ts';
import { FOOTER_UTILITY_NAV, MENU_UTILITY_NAV, PRIMARY_NAV, buildNav } from '../lib/navigation.ts';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  site: Site;
  route: RouteDef;
  title: string;
}
const { site, route, title } = Astro.props;
const { env } = site;
const noindex = route.noindex || env.siteEnv !== 'production';
const bodyAttrs = route.kind === 'notice' ? { 'data-notice-page': '' } : {};
// Preload only the body file for the page's script (0024 point 5).
const bodyFont =
  route.lang === 'hi'
    ? '/fonts/noto-serif-devanagari-devanagari-400-normal.woff2'
    : '/fonts/source-serif-4-latin-400-normal.woff2';
const nav = (defs: Parameters<typeof buildNav>[0]) =>
  buildNav(defs, route.lang, site.routes, site.visibility, route.path);
const primary = nav(PRIMARY_NAV);
---

<!doctype html>
<html lang={route.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={withBase(env, bodyFont)} as="font" type="font/woff2" crossorigin />
    {!route.noindex && <link rel="canonical" href={env.siteUrl + route.path} />}
    {hreflangLinks(route, env.siteUrl).map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body {...bodyAttrs}>
    <a class="skip-link type-label" href="#main">
      {site.t('ui.skip', route.lang)}
    </a>
    {env.siteEnv === 'preview' && (
      <div class="preview-banner type-label" data-preview-only role="note">
        पूर्वावलोकन — सार्वजनिक नहीं · Preview — not public
      </div>
    )}
    <Header site={site} route={route} primary={primary} utility={nav(MENU_UTILITY_NAV)} />
    <main id="main" class="frame" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} lang={route.lang} primary={primary} utility={nav(FOOTER_UTILITY_NAV)} />
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: 1;
      padding: var(--space-2) var(--space-4);
      background-color: var(--color-background);
      transform: translateY(-200%);
    }
    .skip-link:focus {
      transform: none;
    }

    .preview-banner {
      padding: var(--space-2) var(--space-gutter);
      background-color: var(--color-surface);
      color: var(--color-text);
      border-block-end: var(--border-hairline) solid var(--color-border-control);
    }

    main:focus {
      outline: none;
    }
  }
</style>
