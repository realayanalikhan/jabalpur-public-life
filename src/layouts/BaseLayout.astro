---
/**
 * Base document for every page (scaffold plan §8–§9, §12). Handles lang, canonical, hreflang (genuine
 * equivalents only, x-default → /hi/), noindex (notice pages; every page outside production), the
 * preview-only banner, the global styles and the body-font preload. Foundation only: the final
 * header, navigation and footer come in later PRs.
 */
import '../styles/global.css';
import type { Site } from '../lib/site.ts';
import { hreflangLinks, otherLang, type RouteDef } from '../lib/routes.ts';
import { withBase } from '../lib/env.ts';
import LanguageSwitch from '../components/site/LanguageSwitch.astro';

interface Props {
  site: Site;
  route: RouteDef;
  title: string;
}
const { site, route, title } = Astro.props;
const { env } = site;
const noindex = route.noindex || env.siteEnv !== 'production';
const bodyAttrs = route.kind === 'notice' ? { 'data-notice-page': '' } : {};
// Preload only the body file for the page's script (0024 point 5).
const bodyFont =
  route.lang === 'hi'
    ? '/fonts/noto-serif-devanagari-devanagari-400-normal.woff2'
    : '/fonts/source-serif-4-latin-400-normal.woff2';
---

<!doctype html>
<html lang={route.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {!route.noindex && <link rel="canonical" href={env.siteUrl + route.path} />}
    {hreflangLinks(route, env.siteUrl).map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body {...bodyAttrs}>
    <a class="skip-link type-label" href="#main">
      {site.t('ui.skip', route.lang)}
    </a>
    {env.siteEnv === 'preview' && (
      <div class="preview-banner type-label" data-preview-only role="note">
        पूर्वावलोकन — सार्वजनिक नहीं · Preview — not public
      </div>
    )}
    <header class="frame site-header">
      <LanguageSwitch site={site} href={withBase(env, route.switchTo)} target={otherLang(route.lang)} />
    </header>
    <main id="main" class="frame" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: 1;
      padding: var(--space-2) var(--space-4);
      background-color: var(--color-background);
      transform: translateY(-200%);
    }
    .skip-link:focus {
      transform: none;
    }

    .preview-banner {
      padding: var(--space-2) var(--space-gutter);
      background-color: var(--color-surface);
      color: var(--color-text);
      border-block-end: var(--border-hairline) solid var(--color-border-control);
    }

    .site-header {
      display: flex;
      justify-content: flex-end;
      padding-block: var(--space-2);
    }

    main:focus {
      outline: none;
    }
  }
</style>
